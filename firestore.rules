rules_version = '2';
// Tijdkompas — wie mag wat
//   gebruikers/{uid}               alleen jijzelf
//   lijsten/{id}                   leden lezen en schrijven; wie uitgenodigd is mag de lijst zien en zichzelf toevoegen
//   lijsten/{id}/items/{item}      alle leden van de lijst
service cloud.firestore {
  match /databases/{db}/documents {
    function ingelogd() { return request.auth != null; }
    function mijnMail() { return request.auth.token.email.lower(); }

    match /gebruikers/{uid} {
      allow read, write: if ingelogd() && request.auth.uid == uid;
    }

    match /lijsten/{lijst} {
      function lid() { return ingelogd() && request.auth.uid in resource.data.leden; }
      function uitgenodigd() { return ingelogd() && request.auth.token.email != null && mijnMail() in resource.data.uitgenodigd; }

      allow read: if lid() || uitgenodigd();
      allow create: if ingelogd() && request.resource.data.eigenaar == request.auth.uid
                    && request.auth.uid in request.resource.data.leden;
      allow update: if (lid() && request.resource.data.eigenaar == resource.data.eigenaar)
                    || (uitgenodigd()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leden', 'uitgenodigd', 'ledenInfo'])
                        && request.resource.data.leden.removeAll(resource.data.leden).hasOnly([request.auth.uid])
                        && resource.data.leden.removeAll(request.resource.data.leden).size() == 0);
      allow delete: if ingelogd() && resource.data.eigenaar == request.auth.uid;

      match /items/{item} {
        function lidVan(pad) { return ingelogd() && request.auth.uid in pad.data.leden; }
        allow read:            if lidVan(get(/databases/$(db)/documents/lijsten/$(lijst)));
        allow create, update:  if lidVan(getAfter(/databases/$(db)/documents/lijsten/$(lijst)));
        allow delete:          if lidVan(get(/databases/$(db)/documents/lijsten/$(lijst)));
      }
    }
  }
}
